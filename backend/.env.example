# Copy this file to .env and fill in your values

# ── Database ──────────────────────────────────────────
# Local (used when running without Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/algomentor
# Docker Compose (set automatically by docker-compose.yml)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/algomentor

# ── Code Execution ────────────────────────────────────
# Self-hosted Piston (Docker Compose)
# PISTON_URL=http://piston:2000/api/v2
# Local Piston (if running piston separately)
# PISTON_URL=http://localhost:2000/api/v2
# Public Piston API (fallback, no setup needed)
# PISTON_URL=https://emkc.org/api/v2/piston  ← default if not set

# ── Redis (rate limiting) ─────────────────────────────
# Docker Compose
# REDIS_URL=redis://redis:6379
# Local Redis
REDIS_URL=redis://localhost:6379
# Falls back to in-memory if not set

# ── Auth ──────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-in-production

# ── AI (SiliconFlow) ─────────────────────────────────
# Get your key at: https://siliconflow.cn
SILICONFLOW_API_KEY=

# ── Debug ─────────────────────────────────────────────
# Set to "true" to print SQL queries (development only)
SQL_ECHO=false
